# VoxTale editor environment. Copy to .env and uncomment what you need.
#
# No key is required:
# - Without OPENROUTER_API_KEY the agent labels footage itself (harness mode).
# - Without ASSEMBLYAI_API_KEY transcription runs on this machine (Parakeet;
#   run tools/fetch-parakeet.sh once).
#
# WARNING: bun loads .env on its own. A key here arms paid calls in every
# bun command run from this folder.

# --- Keys (both optional, both paid) ---
# OpenRouter: footage labels at open, CLI planning stages, graphics writer.
# OPENROUTER_API_KEY=
# AssemblyAI: when set, it is the transcription engine.
# ASSEMBLYAI_API_KEY=
# AssemblyAI region: unset = US; eu = EU endpoint.
# ASSEMBLYAI_REGION=

# --- MCP server ---
# http or stdio. Default: stdio when started with pipes, else http.
# VOXTALE_EDITOR_TRANSPORT=
# HTTP port. Default 7820.
# VOXTALE_EDITOR_PORT=
# HTTP bearer token. Default: made once in ~/.voxtale-editor/mcp-token.
# VOXTALE_EDITOR_TOKEN=
# Footage folder when a call names none. Default: the working folder.
# EDIT_FOLDER=
# Seconds of quiet after which the next change keeps a version first. Default 600; 0 = never.
# VOXTALE_EDITOR_VERSION_IDLE=
# 0 or false skips the A/V offset check on talk clips. Default on.
# VOXTALE_EDITOR_AV_CHECK=

# --- Transcription ---
# auto | local | assemblyai. Default auto: AssemblyAI with a key, else local Parakeet.
# VOXTALE_EDITOR_TRANSCRIBE=
# cpu makes an Apple Silicon Mac use the ONNX model instead of MLX. Default unset.
# VOXTALE_EDITOR_ASR=

# --- Footage labels / vision ---
# openrouter | harness. Default openrouter with OPENROUTER_API_KEY, else harness
# (the agent labels via label_footage / save_labels; no server model call).
# VOXTALE_EDITOR_VISION=
# OpenRouter vision model for labels. Default google/gemini-3.8-flash.
# VIDEO_INDEX_MODEL=
# OpenRouter model for video moments. Default google/gemini-3.8-flash.
# VIDEO_MOMENTS_MODEL=
# OpenRouter model for CLI take selection and graphics planning. Default anthropic/claude-sonnet-4.6.
# VIDEO_EDIT_MODEL=
# OpenRouter model that writes graphics. Default anthropic/claude-opus-5.5.
# VIDEO_GRAPHIC_MODEL=

# --- Render / encode ---
# auto | software | an ffmpeg encoder name. Default auto (hardware after a test encode, else libx264).
# VOXTALE_EDITOR_ENCODER=
# Scratch disk for renders (holds whole clips). Default: system temp.
# VIDEO_SCRATCH_DIR=
# Browser binary for rendering. Default: the bundled one.
# VIDEO_BROWSER_EXECUTABLE=
# Folder of maker LUTs. Default models/luts (tools/fetch-dji-luts.sh).
# VOXTALE_EDITOR_LUTS=

# --- Graphics ---
# off turns graphics off. Default on.
# VOXTALE_GRAPHICS=
# remotion | hyperframes. Default remotion.
# VOXTALE_GRAPHICS_RENDERER=
# Sandbox image tags. Defaults voxtale-remotion-sandbox:2, voxtale-hyperframes-sandbox:1, voxtale-graphics-sandbox:1.
# VOXTALE_REMOTION_IMAGE=
# VOXTALE_HF_IMAGE=
# VOXTALE_GRAPHICS_IMAGE=
# Style folders. Default ~/.voxtale-editor/styles.
# VOXTALE_STYLES=

# --- Paths / binaries ---
# ffmpeg / ffprobe. Default: found on PATH (old SUPERTALE_FFMPEG / SUPERTALE_FFPROBE still work).
# VOXTALE_EDITOR_FFMPEG=
# VOXTALE_EDITOR_FFPROBE=
# Python interpreter. Default the repo's .venv (old SUPERTALE_PYTHON still works).
# VOXTALE_EDITOR_PYTHON=
# uv binary. Default uv on PATH (old SUPERTALE_UV still works).
# VOXTALE_EDITOR_UV=
# yt-dlp binary for download and live URLs. Default yt-dlp on PATH.
# VOXTALE_YTDLP=
# Model files. Defaults in models/ (tools/fetch-object-model.sh, bun run setup).
# VOXTALE_OBJECT_ENCODER=
# VOXTALE_OBJECT_DECODER=
# VOXTALE_SUBJECT_MODEL=
# 1 skips setup during bun install. Default unset.
# VOXTALE_EDITOR_SKIP_SETUP=
# Prompt version override, id=N,... Internal experiments only.
# VOXTALE_EDITOR_PROMPTS=

# --- Tests ---
# 1 rewrites golden export files.
# UPDATE_GOLDEN=
# 1 runs the slow render integration test.
# VIDEO_RENDER_TEST=
